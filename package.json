{
  "name": "car-crash-lawyer-ai-system",
  "version": "2.0.14",
  "description": "Image processor and PDF generator for Car Crash Lawyer AI",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint src/ --ext .js --fix",
    "format": "prettier --write 'src/**/*.js' '*.js' '*.md' '*.json'",
    "audit": "npm audit --audit-level moderate",
    "depcheck": "depcheck --ignores='eslint,prettier,nodemon,npm-check-updates'",
    "health": "node scripts/health-check.js",
    "clean": "rm -rf node_modules/.cache tmp/ *.log uploads/temp*",
    "deps:update": "ncu -u --target minor",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "validate:lockfile": "npm install --package-lock-only && git diff --exit-code package-lock.json || (echo '❌ package-lock.json is out of sync! Run: npm install --package-lock-only' && exit 1)",
    "validate:pdf-mapping": "node verify-complete-pdf-mapping.js"
  },
  "dependencies": {
    "@adobe/pdfservices-node-sdk": "^4.1.0",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/supabase-js": "^2.93.3",
    "archiver": "^7.0.1",
    "axios": "^1.13.4",
    "body-parser": "^2.2.2",
    "capacitor-native-biometric": "^4.2.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "lru-cache": "^11.2.5",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "openai": "^5.23.2",
    "path": "^0.12.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "puppeteer": "^24.36.1",
    "qrcode": "^1.5.4",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.0",
    "uuid": "^9.0.1",
    "validator": "^13.15.26",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.37.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "npm-check-updates": "^19.0.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
